# ==============================================================================
# CITADEL EDUCATION AGENT - ENVIRONMENT CONFIGURATION
# Startup: CITADEL | Product: Education Agent
# Tagline: "Learn Smarter. Grow Faster. Achieve More."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Engine (Server-side only)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left empty, CITADEL automatically activates high-fidelity pedagogical fallbacks.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Optional pro model for complex reasoning and career gap analysis
GEMINI_PRO_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database, Auth & pgvector
# Run migrations from supabase/migrations/ in sequence:
# 1. 20261110_init_citadel.sql
# 2. 20261110_phase4_intelligence.sql
# 3. 20261110_phase5_saas.sql
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Commercial SaaS & Payment Gateways (Stripe & Razorpay Architecture)
# Webhook signatures must be verified before granting Student Pro or Institution seats.
# ------------------------------------------------------------------------------
# Stripe Integration
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Razorpay Integration (Alternative regional gateway)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ------------------------------------------------------------------------------
# 4. SaaS Quotas & Token Consumption Defaults
# ------------------------------------------------------------------------------
FREE_TIER_MONTHLY_AI_LIMIT=50
FREE_TIER_MAX_DOCUMENTS=3
PRO_TIER_MONTHLY_AI_LIMIT=500
PRO_TIER_MAX_DOCUMENTS=50
INSTITUTION_DEFAULT_SEAT_POOL=500

# ------------------------------------------------------------------------------
# 5. Application Branding & Public Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CITADEL Education Agent"
NEXT_PUBLIC_APP_TAGLINE="Learn Smarter. Grow Faster. Achieve More."
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
